<!--
  Foquinho no Openbox: atalhos pelo rc.xml (opcional)

  O Foquinho já registra os atalhos globais sozinho (Super+Alt+N, F, H, D, M, Espaço, ponto e vírgula).
  Prefere deixar tudo no rc.xml? Então:
    1. desligue os atalhos internos deixando os valores vazios em ~/.config/foco-maxrc:
         [shortcuts]
         quick-add=
         toggle-panel=
         ...
    2. cole os <keybind> abaixo dentro de <keyboard> no ~/.config/openbox/rc.xml
    3. recarregue o Openbox (menu da área de trabalho › Reconfigure)
-->
<keybind key="W-A-n">
  <action name="Execute"><command>foco-max add</command></action>
</keybind>
<keybind key="W-A-f">
  <action name="Execute"><command>foco-max toggle</command></action>
</keybind>
<keybind key="W-A-h">
  <action name="Execute"><command>foco-max hide</command></action>
</keybind>
<keybind key="W-A-d">
  <action name="Execute"><command>foco-max done</command></action>
</keybind>
<keybind key="W-A-m">
  <action name="Execute"><command>foco-max screen next</command></action>
</keybind>
<keybind key="W-A-space">
  <action name="Execute"><command>foco-max play</command></action>
</keybind>
<keybind key="W-A-period">
  <action name="Execute"><command>foco-max next</command></action>
</keybind>
<keybind key="W-A-comma">
  <action name="Execute"><command>foco-max prev</command></action>
</keybind>

<!-- Bônus: as teclas de mídia do teclado controlando a música do notch -->
<keybind key="XF86AudioPlay">
  <action name="Execute"><command>foco-max play</command></action>
</keybind>
<keybind key="XF86AudioNext">
  <action name="Execute"><command>foco-max next</command></action>
</keybind>
<keybind key="XF86AudioPrev">
  <action name="Execute"><command>foco-max prev</command></action>
</keybind>
