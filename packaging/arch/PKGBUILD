# Foquinho para Openbox (e outros gerenciadores X11) — pacote do Arch Linux
#
#   cd packaging/arch && makepkg -si
#
# Compila direto do GitHub. Para a versão KDE Plasma, use `make install` na raiz do repositório.
pkgname=foquinho-openbox-git
pkgver=1.1.r0.g0000000
pkgrel=1
pkgdesc="Notch de foco animado no topo da tela, com fila de demandas, cronômetro e player de música (Openbox/X11)"
arch=('x86_64' 'aarch64')
url="https://github.com/Vitorprogrammerjunior/Foquinho"
license=('unknown')
depends=('qt6-base' 'qt6-declarative' 'libxcb' 'hicolor-icon-theme')
makedepends=('git' 'pkgconf')
optdepends=('picom: transparência e sombras de verdade (sem ele o notch é recortado e funciona igual)'
            'libpulse: parec, para as ondinhas seguirem a batida da música'
            'python-xdg: o openbox-session ler ~/.config/autostart'
            'gtk3: gtk-launch, para abrir o Spotify ao clicar no DVD')
provides=('foquinho')
conflicts=('foquinho' 'foquinho-git')
source=("foquinho::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd foquinho
  printf "1.1.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd foquinho
  make PLATFORM=openbox PREFIX=/usr
}

package() {
  cd foquinho
  make PLATFORM=openbox PREFIX=/usr DESTDIR="$pkgdir" install
}
